{
  "name": "hoodset",
  "version": "2.16.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-live.mjs",
    "dev": "node --env-file-if-exists=.env scripts/dev-server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:contracts": "node --test tests/*.integration.mjs",
    "compile": "node scripts/compile-contracts.mjs",
    "db:generate": "drizzle-kit generate --config=drizzle.config.js",
    "build:vercel": "node scripts/build-vercel.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@vercel/functions": "3.11.4",
    "ethers": "6.17.0"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "esbuild": "0.28.2",
    "solc": "0.8.39"
  },
  "overrides": {
    "tmp": "0.2.7"
  },
  "engines": {
    "node": "24.x"
  }
}
