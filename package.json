{
  "name": "hoodset",
  "version": "2.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-live.mjs",
    "dev": "node --env-file-if-exists=.env scripts/dev-server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:contracts": "node --test tests/contracts.integration.mjs",
    "compile": "node scripts/compile-contracts.mjs",
    "db:generate": "drizzle-kit generate --config=drizzle.config.js"
  },
  "dependencies": {
    "ethers": "6.17.0",
    "@openzeppelin/contracts": "5.6.1"
  },
  "devDependencies": {
    "solc": "0.8.39",
    "esbuild": "0.28.2",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
