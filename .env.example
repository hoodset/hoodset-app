# Set these with native Sites runtime environment settings. Never expose them in browser code.
# Optional but recommended for reliable production reads; an HTTP RH mainnet JSON-RPC endpoint.
RH_RPC_URL=
# OpenOcean public swaps need no API key. No 0x fallback is configured.
# Historical underlying daily prices. A key alone does not grant public display rights.
TWELVE_DATA_API_KEY=
# Enable only after your provider agreement permits this deployment's external display
# and distribution. Basic and personal plans are not enough for the public Site.
# TWELVE_DATA_DISPLAY_RIGHTS=external-display
